# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
DATABASE_URL=postgresql://btqswap:btqswap@localhost:5432/btqswap

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_EXPIRES_IN=24h

# BTQ Core RPC
BTQ_RPC_HOST=127.0.0.1
BTQ_RPC_PORT=8332
BTQ_RPC_USER=btqrpc
BTQ_RPC_PASS=btqrpcpass
BTQ_RPC_WALLET=platform_wallet
BTQ_NETWORK=mainnet

# Platform BTQ wallet
PLATFORM_BTQ_ADDRESS=btq1q...
PLATFORM_DILITHIUM_PUBKEY=...hex...

# Ethereum / EVM
EVM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
EVM_CHAIN_ID=1
EVM_PRIVATE_KEY=0x...
HTLC_CONTRACT_ADDRESS=0x...
USDT_TOKEN_ADDRESS=0xdAC17F958D2ee523a2206206994597C13D831ec7

# Timelocks
BTQ_TIMELOCK_BLOCKS=144
EVM_TIMELOCK_SECONDS=3600
