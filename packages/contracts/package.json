{
	"name": "@btq-swap/contracts",
	"version": "0.1.0",
	"private": true,
	"devDependencies": {
		"@nomicfoundation/hardhat-toolbox": "^2.0.2",
		"@nomicfoundation/hardhat-verify": "^2.0.5",
		"@nomiclabs/hardhat-ethers": "^2.2.3",
		"chai": "^4.3.10",
		"ethereum-waffle": "^4.0.10",
		"ethers": "^5.7.2",
		"hardhat": "^2.19.1",
		"prettier": "^3.1.0",
		"prettier-plugin-solidity": "^1.3.1"
	},
	"dependencies": {
		"@openzeppelin/contracts": "^5.0.0",
		"dotenv": "^16.3.1"
	},
	"scripts": {
		"compile": "npx hardhat compile",
		"test": "npx hardhat test",
		"format": "npx prettier --write './**/*.{sol,ts,tsx,json,md}'",
		"format-contracts": "npx prettier --write --plugin=prettier-plugin-solidity 'contracts/**/*.sol'",
		"deploy:erc20": "npx hardhat run scripts/HTLCERC20/deploy.ts",
		"deploy:native": "npx hardhat run scripts/HTLCNative/deploy.ts",
		"deploy:mock-usdt": "npx hardhat run scripts/deployMockUSDT.ts"
	}
}
