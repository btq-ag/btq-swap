# Template — generate real values with: deploy/make-env.sh <public-url>
NODE_ENV=production
LOG_LEVEL=info
DEVNET=1
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
PUBLIC_EVM_RPC_URL=http://localhost:5173/api/rpc/evm
TRUST_PROXY=1
POSTGRES_PASSWORD=<random hex>
ADMIN_TOKEN=<random hex>
SESSION_SECRET=<random hex>
HEALTH_DEEP_TOKEN=<random hex>
BTQ_NETWORK=regtest
BTQ_RPC_USER=btqswap
BTQ_RPC_PASS=<random hex>
BTQ_PLATFORM_WALLET=platform
BTQ_TARGET_BLOCK_SEC=5
BTQ_MIN_CONFIRMATIONS=1
BTQ_FEE_RATE_SAT_VB=2
PLATFORM_HTLC_SEED=<random hex>
PLATFORM_SECRET_KEY=<random hex>
EVM_CHAIN_ID=31337
EVM_PRIVATE_KEY=<0x + 64 hex>
DEVNET_FAUCET_EVM_KEY=<0x + 64 hex>
EVM_MIN_CONFIRMATIONS=1
# Optional. Leave SOLANA_RPC_URL empty to use the public devnet list.
# A set value replaces that list, so a local validator is not mixed with public devnet.
SOLANA_RPC_URL=
PUBLIC_SOLANA_RPC_URL=
SOLANA_HTLC_PROGRAM_ID=
SOLANA_TOKEN_MINT=
SOLANA_PLATFORM_SECRET=
SWAP_BUYER_LOCK_WINDOW_SEC=900
SWAP_EVM_LOCK_DURATION_SEC=8100
SWAP_EVM_LOCK_MAX_DURATION_SEC=14400
SWAP_SELLER_LOCK_WINDOW_SEC=900
SWAP_BTQ_LOCK_BLOCKS=720
SWAP_SAFETY_MARGIN_SEC=3600
WORKER_TICK_MS=1500
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_SWAP_CHANNEL_ID=
DISCORD_FEED_CHANNEL_ID=
DISCORD_ADMIN_IDS=
DISCORD_ENABLE_FEED=1
DISCORD_ENABLE_DMS=1
WEB_PORT=5173
